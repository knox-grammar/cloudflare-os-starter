{
  "name": "cloudflare-os-starter",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "build": "vp run -r --cache build",
    "test": "node --test 'scripts/**/*.test.ts' && vp run --filter '!cloudflare-os-starter' --filter '!@gadgets/scripts' --filter '!@gadgets/gatekeeper-kit' --filter '!@gadgets/observability' --cache test",
    "types:scripts": "tsc -p scripts/tsconfig.json",
    "lint:check": "vp lint",
    "lint:fix": "vp lint --fix",
    "lint": "pnpm run lint:check && pnpm run types:scripts && pnpm run build",
    "check": "node scripts/deploy.ts --check",
    "check:staging": "node scripts/deploy.ts --target staging --check",
    "check:staging:bootstrap": "node scripts/deploy.ts --target staging --bootstrap --check",
    "deploy": "node scripts/deploy.ts",
    "deploy:staging": "node scripts/deploy.ts --target staging",
    "deploy:staging:bootstrap": "node scripts/deploy.ts --target staging --bootstrap",
    "secrets:set": "CLOUDFLARE_ACCOUNT_ID=2ddaede0fbdd479a6bf410a5f1eb76ad op run --env-file=./scripts/.deploy.env -- node scripts/set-remote-secrets.ts"
  },
  "devDependencies": {
    "@1password/sdk": "^0.5.0",
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@types/node": "26.1.0",
    "jsonc-parser": "^3.3.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  }
}
