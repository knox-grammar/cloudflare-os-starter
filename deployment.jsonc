{
  // Knox Grammar School Enterprise.
  "accountId": "2ddaede0fbdd479a6bf410a5f1eb76ad",

  // null derives it from workers.router.route.customDomain below.
  "publicBaseUrl": null,

  // Worker names are permanent service identities and cannot be renamed without stranding the
  // Durable Objects and storage that belong to them. Verified free in this account 2026-08-25;
  // note the existing unrelated "knoxi-os" showcase Worker, which these must not collide with.
  "workers": {
    "router": {
      "name": "knox-os",

      // Verified free 2026-08-25: zone knoxi.dev is active in this account, no existing DNS
      // record or Worker custom domain for this hostname.
      "route": { "customDomain": "os.knoxi.dev" }
    },

    "workshop": { "name": "knox-os-workshop" },
    "context": { "name": "knox-os-context" },
    "scheduler": { "name": "knox-os-scheduler" },
    "customGatekeeper": { "name": "knox-os-gatekeeper" },

    // Delegated OAuth to Microsoft Graph (Outlook Mail, Outlook Calendar, and selected SharePoint
    // files/folders). See packages/gatekeeper-microsoft/ and
    // plans/microsoft-sharepoint-and-work-iq.md. Outlook and read-only SharePoint access to the
    // administrator-selected digital-utilities site are live; broader authority remains deferred.
    "gatekeeperMicrosoft": { "name": "knox-os-gatekeeper-microsoft" },
    "gatekeeperWorkIQ": { "name": "knox-os-gatekeeper-workiq" },

    "errorReporter": { "name": "knox-os-error-reporter" }
  },

  // From the self-hosted Access application protecting the router hostname. Create it before
  // deploying, then copy the team domain and the application audience tag.
  // https://developers.cloudflare.com/cloudflare-one/access-controls/applications/http-apps/authorization-cookie/validating-json/#get-your-aud-tag
  "access": {
    "issuer": "https://knoxgrammar.cloudflareaccess.com",
    "audience": "8623541e237ab1d2eee15a213ba7539c45e20f9e8f922c62aa6f78571c9fad6a",
    "admins": ["carrickm@knox.nsw.edu.au"]
  },

  // Workers AI through the account's own AI Gateway. Reached over the Workshop's WORKERS_AI
  // binding, which is pre-authenticated in-account, so no CF_AI_GATEWAY_API_TOKEN is needed.
  "aiGateway": {
    "enabled": true,
    "name": "default",
    "accountId": null,
    "providers": ["cloudflare"]
  },

  "context": {
    // null scopes Context data to the public origin. Changing the hostname later moves this
    // boundary and hides existing collections, so pin it to a literal once data exists.
    "sharingDomain": null,

    "kvNamespaceId": "41215b18a40b4d0e83ecd44efb1d8cde"
  },

  // Agent code's Temporal `time.js` module uses this rather than the Worker runtime's UTC clock.
  "agent": { "timeZone": "Australia/Sydney" },

  "customGatekeeper": {
    "name": "Knox Grammar School",
    "message": "Read-only deployment information for the Knox OS instance. Ask about the deployment environment and configured integrations."
  },

  "errorReporting": {
    "enabled": true,
    "environment": "production",
    "release": null
  },

  // Carry existing production storage across clean CI runners; never provision replacements.
  "resources": {
    "blueprintsKvNamespaceId": "44cfaa3b0d634752abac0bfb7dd111fc",
    "avatarsKvNamespaceId": "2e8610c47a5c4d0198a9d4c04d7645a7",
    "blueprintContentBucket": "knox-os-workshop-blueprint-content"
  },

  "observability": {
    "enabled": true,
    "headSamplingRate": 1,
    "logs": { "invocationLogs": false },
    "traces": { "enabled": false, "headSamplingRate": 0.1 }
  }
}
