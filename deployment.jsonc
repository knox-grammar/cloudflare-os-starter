{
  // Knox Grammar School Enterprise.
  "accountId": "2ddaede0fbdd479a6bf410a5f1eb76ad",

  // null derives it from workers.router.route.customDomain below.
  "publicBaseUrl": null,

  // Worker names are permanent service identities and cannot be renamed without stranding the
  // Durable Objects and storage that belong to them. Verified free in this account 2026-08-25;
  // note the existing unrelated "knoxi-os" showcase Worker, which these must not collide with.
  "workers": {
    "router": {
      "name": "knox-os",

      // Verified free 2026-08-25: zone knoxi.dev is active in this account, no existing DNS
      // record or Worker custom domain for this hostname.
      "route": { "customDomain": "os.knoxi.dev" }
    },

    "workshop": { "name": "knox-os-workshop" },
    "context": { "name": "knox-os-context" },
    "scheduler": { "name": "knox-os-scheduler" },
    "customGatekeeper": { "name": "knox-os-gatekeeper" },

    // The Web Search Gatekeeper, which lets agents search the public web. Ambient, like Context.
    // Searches are billed separately from models: load AI Gateway credits on the account, or store
    // a Ceramic key (alias "default") on the gateway. See docs/customization.md#workers-and-routing.
    "websearch": { "name": "knox-os-gk-websearch" },

    "errorReporter": { "name": "knox-os-error-reporter" }
  },

  // Optional upstream Gatekeepers (GitHub, Slack, ...), keyed by slug, each its own Worker:
  //   "github": { "name": "<router-name>-gk-github" }
  // `pnpm cf-os init` offers them; `pnpm cf-os secrets` sets their OAuth credentials.
  // Reference: docs/customization.md#optional-gatekeepers
  "gatekeepers": {
    // Upstream's Microsoft 365 Gatekeeper (SharePoint, OneDrive, Outlook, Calendar), delegated
    // OAuth through the Knox Entra app. Its OAuth redirect is <origin>/gatekeeper/microsoft/oauth.
    // Secrets CLIENT_ID, CLIENT_SECRET and MICROSOFT_TENANT_ID go on the Worker with
    // `pnpm cf-os secrets microsoft`, never here. These vars cap what agents may do: only
    // admin-granted SharePoint sites, read-only; Outlook drafts but never sends; Calendar edits
    // but never invites. See cloudflare-os/packages/gatekeeper-microsoft/README.md.
    "microsoft": {
      "name": "knox-os-gk-microsoft",
      "vars": {
        "MICROSOFT_SHAREPOINT_SITES": "selected",
        "MICROSOFT_SHAREPOINT_ACCESS": "read",
        "MICROSOFT_OUTLOOK_ACCESS": "draft",
        "MICROSOFT_CALENDAR_ACCESS": "edit"
      }
    }
  },

  // This starter deploys Cloudflare Access mode. Cloudflare OS also supports built-in password
  // accounts and auth Gatekeeper sign-in; see the reference below before switching. The audience
  // comes from the self-hosted Access application protecting the public hostname: `pnpm cf-os init`
  // sets it all up, or set "admins" and `pnpm cf-os access` finds or creates that application and
  // fills in issuer and audience.
  // "admins" gates /admin in every sign-in method.
  // Reference: docs/customization.md#sign-in-methods
  "access": {
    "issuer": "https://knoxgrammar.cloudflareaccess.com",
    "audience": "8623541e237ab1d2eee15a213ba7539c45e20f9e8f922c62aa6f78571c9fad6a",
    "admins": ["carrickm@knox.nsw.edu.au"]
  },

  // Workers AI through the account's own `knox-os` AI Gateway, which Web Search searches through
  // too. Reached over the WORKERS_AI and AI bindings, which are pre-authenticated in-account, so the
  // gateway's required authentication needs no CF_AI_GATEWAY_API_TOKEN.
  "aiGateway": {
    "enabled": true,
    "name": "knox-os",
    "accountId": null,
    "providers": ["cloudflare"]
  },

  "context": {
    // null scopes Context data to the public origin. Changing the hostname later moves this
    // boundary and hides existing collections, so pin it to a literal once data exists.
    "sharingDomain": null,

    "kvNamespaceId": "41215b18a40b4d0e83ecd44efb1d8cde"
  },

  // Displayed to agents when the example custom integration is enabled in /admin. false deploys none.
  "customGatekeeper": {
    "enabled": true,
    "name": "Knox Grammar School",
    "message": "Read-only deployment information for the Knox OS instance. Ask about the deployment environment and configured integrations."
  },

  "errorReporting": {
    "enabled": true,
    "environment": "production",
    "release": null
  },

  // Carry existing production storage across clean CI runners; never provision replacements.
  "resources": {
    "blueprintsKvNamespaceId": "44cfaa3b0d634752abac0bfb7dd111fc",
    "avatarsKvNamespaceId": "2e8610c47a5c4d0198a9d4c04d7645a7",
    "blueprintContentBucket": "knox-os-workshop-blueprint-content"
  },

  "observability": {
    "enabled": true,
    "headSamplingRate": 1,
    "logs": { "invocationLogs": false },
    "traces": { "enabled": false, "headSamplingRate": 0.1 }
  }
}
