# Production Worker secrets for knox-os-gatekeeper-microsoft, referenced from 1Password rather
# than stored here. Safe to commit: these are op:// paths, not raw values. Resolved and pushed to
# Cloudflare by scripts/set-remote-secrets.ts.
#
# Fill in the real op:// item paths after creating the Azure App Registration -- see
# plans/gatekeeper-microsoft.md. TENANT_ID is not a secret; it's already a plain var in
# wrangler.jsonc, pinned to the Knox tenant.

CLIENT_ID=op://<vault>/<item>/CLIENT_ID
CLIENT_SECRET=op://<vault>/<item>/CLIENT_SECRET
